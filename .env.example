# Put the keys you have. The POC works with any non-empty subset.
# Missing providers are skipped / fall back to an available model.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
XAI_API_KEY=

# Optional defaults (override role → model mapping)
# ROUNDTABLE_ARCHITECT_MODEL=openai:gpt-4.1
# ROUNDTABLE_CODER_MODEL=anthropic:claude-sonnet-4-5
# ROUNDTABLE_REDTEAM_MODEL=xai:grok-3
# ROUNDTABLE_RESEARCHER_MODEL=google:gemini-2.5-pro

# Budget defaults for the Control Plane
ROUNDTABLE_MAX_TOKENS_PER_TASK=200000
ROUNDTABLE_MAX_COST_USD=5
ROUNDTABLE_MAX_ROUNDS=3
ROUNDTABLE_MAX_ATTEMPTS=4
